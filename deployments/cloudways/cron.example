# Cloudways PHP application: enqueue through HTTPS, process through CLI every minute.
# Replace /home/master/applications/<APP>/ and the PHP binary path.
# Runs at most 40 queued jobs per minute. Do not start a server daemon through a web route.
* * * * * /usr/bin/php /home/master/applications/<APP>/cli/worker.php 40 >> /home/master/applications/<APP>/runtime/worker.log 2>&1
